{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "ui_kits/extension/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|uppercase|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, uppercase, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|in|out|warn|info|unknown)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'in' | 'out' | 'warn' | 'info' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|full|active|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, full, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|title|children|action|onDismiss|tooltip|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, icon, title, children, action, onDismiss, tooltip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:guide|info|warn|quiet)$/]",
        "message": "<Callout> tone must be one of 'guide' | 'info' | 'warn' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|icon|count|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, icon, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|showValue|showWord|size|style|key|ref|className|style|children)$/]",
        "message": "<ConfidenceMeter> doesn't accept that prop. Declared props: value, label, showValue, showWord, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceMeter'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<ConfidenceMeter> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourtPoint'] > JSXAttribute > JSXIdentifier[name!=/^(?:x|y|side|key|ref|className|style|children)$/]",
        "message": "<CourtPoint> doesn't accept that prop. Declared props: x, y, side."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourtPoint'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:a|b)$/]",
        "message": "<CourtPoint> side must be one of 'a' | 'b'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DimensionAxis'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<DimensionAxis> doesn't accept that prop. Declared props: label, options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|action|compact|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, body, action, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|active|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|solid)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoTip'] > JSXAttribute > JSXIdentifier[name!=/^(?:term|children|side|size|style|key|ref|className|style|children)$/]",
        "message": "<InfoTip> doesn't accept that prop. Declared props: term, children, side, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoTip'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<InfoTip> side must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyHint'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<KeyHint> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyHint'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent)$/]",
        "message": "<KeyHint> tone must be one of 'neutral' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|label|value|dashed|shape|key|ref|className|style|children)$/]",
        "message": "<LegendItem> doesn't accept that prop. Declared props: color, label, value, dashed, shape."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendItem'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:dot|bar)$/]",
        "message": "<LegendItem> shape must be one of 'dot' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MixSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|key|ref|className|style|children)$/]",
        "message": "<MixSegment> doesn't accept that prop. Declared props: label, value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|mediaTime|stale|actions|collapsed|onToggleCollapse|collapsible|resizable|footer|tone|bodyStyle|draggable|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, icon, mediaTime, stale, actions, collapsed, onToggleCollapse, collapsible, resizable, footer, tone, bodyStyle, draggable."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:glass|solid)$/]",
        "message": "<Panel> tone must be one of 'glass' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RallyRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:rank|rallyId|index|shots|duration|outcome|timestamp|partial|onReview|style|key|ref|className|style|children)$/]",
        "message": "<RallyRow> doesn't accept that prop. Declared props: rank, rallyId, index, shots, duration, outcome, timestamp, partial, onReview, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RallyRow'] > JSXAttribute[name.name='outcome'] > Literal[value!=/^(?:winner|forced error|unforced error|unclassified)$/]",
        "message": "<RallyRow> outcome must be one of 'winner' | 'forced error' | 'unforced error' | 'unclassified'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|disabled|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label, icon, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShotPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|suggested|columns|showKeys|style|key|ref|className|style|children)$/]",
        "message": "<ShotPicker> doesn't accept that prop. Declared props: value, onChange, suggested, columns, showKeys, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|note|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, unit, note, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|muted)$/]",
        "message": "<StatTile> tone must be one of 'default' | 'accent' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatTile> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|detail|pulse|onClick|style|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: state, label, detail, pulse, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:ready|live|waiting|stale|error|off)$/]",
        "message": "<StatusChip> state must be one of 'ready' | 'live' | 'waiting' | 'stale' | 'error' | 'off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|current|labels|style|key|ref|className|style|children)$/]",
        "message": "<StepDots> doesn't accept that prop. Declared props: total, current, labels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StrokeFeedItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:sequence|player|shot|time|status|source|confidence|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<StrokeFeedItem> doesn't accept that prop. Declared props: sequence, player, shot, time, status, source, confidence, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StrokeFeedItem'] > JSXAttribute[name.name='player'] > Literal[value!=/^(?:A|B)$/]",
        "message": "<StrokeFeedItem> player must be one of 'A' | 'B'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StrokeFeedItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:suggested|accepted|corrected|unclassified)$/]",
        "message": "<StrokeFeedItem> status must be one of 'suggested' | 'accepted' | 'corrected' | 'unclassified'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StrokeFeedItem'] > JSXAttribute[name.name='source'] > Literal[value!=/^(?:auto|manual|corrected)$/]",
        "message": "<StrokeFeedItem> source must be one of 'auto' | 'manual' | 'corrected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:shot|confidence|time|onAccept|onCorrect|style|key|ref|className|style|children)$/]",
        "message": "<SuggestionRow> doesn't accept that prop. Declared props: shot, confidence, time, onAccept, onCorrect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|description|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, description, disabled, id, style."
      }
    ]
